          "dispatch",
          "running",
          "done"
        ],
        "note": "从待执行到完成，动作分流决定走哪条支路。"
      },
      {
        "id": "action-branches",
        "label": "三条动作支路",
        "focus": [
          "dispatch",
          "br_notify",
          "br_invoke",
          "running",
          "done"
        ],
        "note": "notify 直达完成，invoke 扇出派发，run 进入执行者自身工作区。"
      },
      {
        "id": "permission-gate",
        "label": "权限判定与等待",
        "focus": [
          "running",
          "waiting",
          "aborted"
        ],
        "note": "未命中工作区即索取完全权限，等待授权是可返回的等待态。"
      },
      {
        "id": "recovery-loop",
        "label": "失败与重试",
        "focus": [
          "running",
          "failed"
        ],
        "note": "执行失败可重试，级联深度上限 3 且带 visited 防自激。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "主轨状态"
    },
    {
      "id": "side",
      "label": "动作支路 · 权限等待"
    },
    {
      "id": "terminal",
      "label": "等待 · 失败 · 出口"
    }
