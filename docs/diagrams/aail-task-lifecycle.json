      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "入口"
    },
    {
      "id": "scheduler",
      "type": "active",
      "label": "到期触发",
      "sublabel": "算 next-due 后 sleep",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "调度"
    },
    {
      "id": "dispatch",
      "type": "decision",
      "label": "动作分流",
      "sublabel": "按 do.kind 分路",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "分流"
    },
    {
      "id": "running",
      "type": "active",
      "label": "执行中",
      "sublabel": "执行者自有工具 · 角色工作区",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "执行"
    },
    {
      "id": "done",
      "type": "success",
      "label": "完成",
      "sublabel": "执行成功即终态",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "终态"
    },
    {
      "id": "br_invoke",
      "type": "external",
      "label": "派发队列",
      "sublabel": "扇出多角色 · 异步排队",
      "lane": "side",
      "col": 0,
      "width": 96,
      "tag": "invoke"
    },
    {
      "id": "waiting",
      "type": "waiting",
      "label": "等待授权",
      "sublabel": "超出工作区范围",
      "lane": "side",
      "col": 1,
      "width": 96,
      "tag": "非终态"
    },
    {
      "id": "br_notify",
      "type": "external",
      "label": "提醒分级器",
      "sublabel": "L1/L2/L3 分级提醒",
      "lane": "side",
      "col": 2,
      "width": 96,
      "tag": "notify"
    },
    {
      "id": "aborted",
      "type": "failure",
      "label": "已中止",
      "sublabel": "用户拒绝授权",
      "lane": "terminal",
      "col": 1,
      "width": 96,
      "tag": "终态"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "执行失败",
      "sublabel": "可重试",
      "lane": "terminal",
      "col": 2,
      "width": 96,
      "tag": "可恢复"
    }
  ],
