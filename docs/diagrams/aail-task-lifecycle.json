  "cards": [
    {
      "dot": "cyan",
      "title": "审计贯穿",
      "items": [
        "每次派发都记录 caller / target / op / args / depth 与结果",
        "级联调用 depth ≤ 3，visited 集合拦住 A→B→A 自激"
      ]
    },
    {
      "dot": "emerald",
      "title": "git 提交贯穿",
      "items": [
        "每一次落盘变更提交一次",
        "commit message 记录 任务 + 角色 + 动作摘要"
      ]
    },
    {
      "dot": "amber",
      "title": "权限边界",
      "items": [
        "命中工作区（角色自有 + 用户显式添加目录）直接执行：查 / 改全权",
        "未命中 → 需要完全权限 → 等待授权，可勾选「不再询问」并按 角色 + 能力 + 路径前缀 记住"
      ]
    },
    {
      "dot": "rose",
      "title": "支路出口与恢复",
      "items": [
        "notify 直达完成：L1 静默 / L2 系统通知 / L3 强提醒置顶窗",
        "invoke 走派发队列扇出多角色，异步排队、一次失败不阻塞其他",
        "run 在角色自有工作区内执行；执行失败可重试，拒绝授权则中止"
      ]
    }
  ]
