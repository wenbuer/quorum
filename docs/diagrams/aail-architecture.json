  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "热键或托盘呼出外壳，单窗口在胶囊态与面板态之间切换",
        "角色注册表按需加载角色包，能力调用一律经权限闸门",
        "权限闸门是角色触达系统能力的唯一通道，并写入审计日志",
        "LLM Provider 一期为 Noop，Ollama 与云提供商后续接入"
      ]
    },
    {
      "dot": "violet",
      "title": "内核零业务",
      "items": [
        "宿主进程里不出现任何业务名词，业务全部下放给角色包",
        "角色包是一个文件夹一个租户：role.json + prompt.md + work/ + tools/ + memory/",
        "角色包的 work/ 是私有存储，宿主不感知其中的业务数据",
        "宿主 SQLite 只存计划、触发日志与授权记录，不存业务数据"
      ]
    },
    {
      "dot": "amber",
      "title": "调度与提醒",
      "items": [
        "到期调度器用最小堆算出 next-due 后 sleep",
        "不放在前端：WebView2 会节流隐藏窗口的 JS 定时器",
        "提醒分级 L1 角标 / L2 系统 toast / L3 自绘置顶强提醒窗"
      ]
    }
  ]
